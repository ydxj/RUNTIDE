# Copy to .env and edit. Never commit the real .env.

# Host port (published on 127.0.0.1 only).
RUNTIDE_PORT=8484

# Initial administrator password. Leave empty to have the server generate one
# and print it once in its log (docker compose logs runtide-server).
RUNTIDE_ADMIN_PASSWORD=

# Set to 1 only when a TLS-terminating proxy fronts the server.
RUNTIDE_SERVER_BEHIND_TLS_PROXY=1
